<mxfile host="app.diagrams.net" agent="Claude Code"><diagram id="63aaa18a049f4bea939d" name="Actores del sistema"><mxGraphModel dx="1250" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="740" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n10" value="1.1.1.1 Actores del sistema" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="700" height="32" as="geometry"/></mxCell><mxCell id="n11" value="Sistema para Pollerías · actores principales (personas) y actores secundarios (sistemas externos)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="800" height="22" as="geometry"/></mxCell><mxCell id="n12" value="Cliente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;dashPattern=6 4;fillColor=#f9fafb;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="230" height="410" as="geometry"/></mxCell><mxCell id="n13" value="Comensal" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffedd5;strokeColor=#c2410c;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="125" y="150" width="40" height="80" as="geometry"/></mxCell><mxCell id="n14" value="Cliente que escanea el código QR de su mesa. Consulta la carta, hace pedidos, llama al mozo y paga desde su propio celular. No necesita registrarse." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="50" y="270" width="190" height="110" as="geometry"/></mxCell><mxCell id="n15" value="Personal del local" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;dashPattern=6 4;fillColor=#f9fafb;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="920" height="410" as="geometry"/></mxCell><mxCell id="n16" value="&lt;i&gt;Personal del local&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=12;fontStyle=3;verticalLabelPosition=middle;labelPosition=left;align=right;verticalAlign=middle;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="725" y="120" width="40" height="80" as="geometry"/></mxCell><mxCell id="n17" value="(actor abstracto: todo el personal inicia sesión con su usuario y PIN)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#374151;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="785" y="135" width="260" height="40" as="geometry"/></mxCell><mxCell id="n18" value="Mozo" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="n19" value="Atiende el salón con la tablet: abre y une mesas, toma pedidos, confirma pedidos QR y atiende los llamados." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="300" y="395" width="170" height="95" as="geometry"/></mxCell><mxCell id="n20" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#374151;edgeStyle=elbowEdgeStyle;elbow=vertical;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n18" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="Maestro pollero" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="n22" value="Recibe en su estación las comandas impresas con alarma sonora. No manipula pantallas." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="480" y="395" width="170" height="95" as="geometry"/></mxCell><mxCell id="n23" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#374151;edgeStyle=elbowEdgeStyle;elbow=vertical;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n21" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="Cajero(a)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="n25" value="Cobra cuentas, emite comprobantes, registra pedidos para llevar y delivery, y cierra su turno con arqueo ciego." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="660" y="395" width="170" height="95" as="geometry"/></mxCell><mxCell id="n26" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#374151;edgeStyle=elbowEdgeStyle;elbow=vertical;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n24" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="Repartidor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="905" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="n28" value="Entrega los pedidos a domicilio con la hoja de ruta, cobra contra entrega y rinde el efectivo." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="840" y="395" width="170" height="95" as="geometry"/></mxCell><mxCell id="n29" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#374151;edgeStyle=elbowEdgeStyle;elbow=vertical;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n27" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1085" y="280" width="40" height="80" as="geometry"/></mxCell><mxCell id="n31" value="Dueño del local. Configura carta, precios y usuarios, autoriza con su PIN y revisa reportes." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="1020" y="395" width="170" height="95" as="geometry"/></mxCell><mxCell id="n32" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#374151;edgeStyle=elbowEdgeStyle;elbow=vertical;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n30" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="Actores secundarios: sistemas externos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;dashPattern=6 4;fillColor=#f9fafb;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="1180" height="170" as="geometry"/></mxCell><mxCell id="n34" value="«sistema externo»&lt;br&gt;&lt;b&gt;Pasarela de pagos&lt;/b&gt;&lt;br&gt;Culqi / Izipay: Yape, Plin y tarjetas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f3e8ff;strokeColor=#7c3aed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="585" width="205" height="90" as="geometry"/></mxCell><mxCell id="n35" value="«sistema externo»&lt;br&gt;&lt;b&gt;SUNAT vía OSE&lt;/b&gt;&lt;br&gt;Nubefact: boletas, facturas y notas de crédito" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f3e8ff;strokeColor=#7c3aed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285" y="585" width="205" height="90" as="geometry"/></mxCell><mxCell id="n36" value="«sistema externo»&lt;br&gt;&lt;b&gt;Consulta DNI / RUC&lt;/b&gt;&lt;br&gt;ApisPeru: nombres y razón social" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f3e8ff;strokeColor=#7c3aed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="515" y="585" width="205" height="90" as="geometry"/></mxCell><mxCell id="n37" value="«sistema externo»&lt;br&gt;&lt;b&gt;Mensajería&lt;/b&gt;&lt;br&gt;WhatsApp Cloud API y correo SMTP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f3e8ff;strokeColor=#7c3aed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="745" y="585" width="205" height="90" as="geometry"/></mxCell><mxCell id="n38" value="«tiempo»&lt;br&gt;&lt;b&gt;Temporizador&lt;/b&gt;&lt;br&gt;Libera pedidos programados y emite la boleta resumen diaria" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f3e8ff;strokeColor=#7c3aed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="585" width="205" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
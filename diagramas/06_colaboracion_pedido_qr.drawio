<mxfile host="app.diagrams.net" agent="Claude Code"><diagram id="9eafb7bebf1c41299973" name="Colaboración - pedido QR"><mxGraphModel dx="1860" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="910" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n10" value="1.1.2.2 Diagrama de colaboración: registrar pedido por QR y enviarlo a cocina" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="n11" value="Mismo flujo que el diagrama de secuencia 1.1.2.1; cada mensaje lleva su número de orden y la flecha indica su dirección" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="n12" value=":Comensal" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffedd5;strokeColor=#c2410c;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="40" height="80" as="geometry"/></mxCell><mxCell id="n13" value=":CartaQR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="350" width="170" height="60" as="geometry"/></mxCell><mxCell id="n14" value=":ApiServidorLocal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontStyle=5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="350" width="200" height="60" as="geometry"/></mxCell><mxCell id="n15" value=":TabletMozo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontStyle=5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="200" height="60" as="geometry"/></mx
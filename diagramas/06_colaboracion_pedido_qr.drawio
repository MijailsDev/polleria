etry></mxCell><mxCell id="n25" value="" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="n13" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="300"/><mxPoint x="527" y="300"/></Array></mxGeometry></mxCell><mxCell id="n28" value="" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.5;exitX=0.1;exitY=1;entryX=0.35;entryY=1;" edge="1" parent="1" source="n14" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="465"/><mxPoint x="950" y="465"/></Array></mxGeometry></mxCell><mxCell id="n29" value="1: escanearQR(M-04) →&lt;br&gt;7: elegirProducto(1/4, presa, cremas) →&lt;br&gt;9: enviarPedido() →&lt;br&gt;← 6: mostrarCarta()&lt;br&gt;← 21: «pedido en preparación»" style="text;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="108" y="262" width="285" height="112" as="geometry"/></mxCell><mxCell id="n30" value="8: validarModificadores()" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="395" y="268" width="180" height="28" as="geometry"/></mxCell><mxCell id="n31" value="2: solicitarCarta(mesa, token) →&lt;br&gt;10: registrarPedido(ítems, clave) →&lt;br&gt;← 5: carta con disponibilidad&lt;br&gt;← 20: pedidoEnviado()" style="text;html=1;align=left;verticalAlign=bottom;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="582" y="280" width="290" height="94" as="geometry"/></mxCell><mxCell id="n32" value="↑ 13: alertarPorConfirmar()&lt;br&gt;↓ 15: confirmarPedido(id)&lt;br&gt;&lt;i&gt;[primer pedido del celular]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="994" y="190" width="260" height="70" as="geometry"/></mxCell><mxCell id="n33" value="← 14: confirmar" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1092" y="92" width="150" height="26" as="geometry"/></mxCell><mxCell id="n34" value="16: confirmarAutomáticamente()&lt;br&gt;&lt;i&gt;[celular ya confirmado]&lt;/i&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="680" y="448" width="212" height="40" as="geometry"/></mxCell><mxCell id="n35" value="↓ 3: buscarOCrearSesion()&lt;br&gt;↓ 11: validarStockYGuardar()&lt;br&gt;↑ 4: sesión y token&lt;br&gt;↑ 12: pedido registrado" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="994" y="520" width="240" height="76" as="geometry"/></mxCell><mxCell id="n36" value="17: encolarComanda() →" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1090" y="346" width="260" height="28" as="geometry"/></mxCell><mxCell id="n37" value="18: imprimir + buzzer →&lt;br&gt;← 19: impresión OK" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1500" y="300" width="170" height="44" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Cómo leerlo:&lt;/b&gt; los números indican el orden de los mensajes. Si el celular hace su primer pedido en la sesión ocurren los pasos 13 a 15 (el mozo confirma); si ya fue confirmado, ocurre el paso 16. Luego la comanda pasa a la cola y se imprime con alarma en la estación del pollero." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="640" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
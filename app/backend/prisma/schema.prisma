/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bitacora {
  id              BigInt   @id(map: "pk_bitacora") @default(autoincrement())
  usuario_id      String?  @db.Uuid
  accion          String   @db.VarChar(50)
  entidad         String   @db.VarChar(40)
  entidad_id      String?  @db.Uuid
  valores_antes   Json?
  valores_despues Json?
  fecha           DateTime @default(now()) @db.Timestamptz(6)
  usuario         usuario? @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bitacora_usuario_id")

  @@index([entidad, entidad_id], map: "ix_bitacora_entidad")
  @@index([fecha], map: "ix_bitacora_fecha")
}


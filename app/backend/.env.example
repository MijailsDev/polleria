# Copia este archivo como .env y completa los valores. El .env NO se sube a GitHub.

# ---------------------------------------------------------------- Básico
DATABASE_URL=postgresql://polleria_app:CAMBIAR@localhost:5432/polleria
PORT=3001
# Tasa de IGV + IPM (MYPE restaurantes 2026: 10.5 %; régimen general: 18 %)
TASA_IMPUESTO=0.105

# ---------------------------------------------------------------- Seguridad
# development: muestra avisos; production: el servidor NO arranca con valores de prueba
NODE_ENV=development
# Clave de las sesiones (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR
# Dominios de la web separados por coma; * solo en desarrollo. Con dos dominios, ambos:
#   CORS_ORIGIN=https://polleria-carta.vercel.app,https://polleria-gestion.vercel.app
CORS_ORIGIN=*
# Solicitudes por minuto por IP (en desarrollo no se limita a la propia laptop)
LIMITE_SOLICITUDES=600
# Equipos vinculados: con NODE_ENV=production siempre se exigen. En desarrollo se activan
# en Administración → Equipos y seguridad (parámetro exigir_equipo_vinculado).

# ---------------------------------------------------------------- Pasarela de pagos (webhook firmado)
PASARELA_SECRETO=CAMBIAR

# ---------------------------------------------------------------- Nube (arquitectura híbrida)
# Sin NUBE_URL se usa el receptor de prueba de esta misma API (/api/nube/eventos)
# NUBE_URL=https://nube.mipolleria.pe/api/nube/eventos
SYNC_SECRET=CAMBIAR

# ---------------------------------------------------------------- Servicios reales (opcionales)
# Sin estas variables se usan las versiones simuladas, con el mismo flujo.
# Facturación electrónica con Nubefact (ruta y token de tu cuenta)
# NUBEFACT_RUTA=https://api.nubefact.com/api/v1/xxxxxxxx
# NUBEFACT_TOKEN=xxxxxxxx
# Consulta de DNI y RUC (dniruc.apisperu.com)
# APISPERU_TOKEN=xxxxxxxx
# WhatsApp Business Cloud API de Meta
# WHATSAPP_TOKEN=xxxxxxxx
# WHATSAPP_PHONE_ID=xxxxxxxx
# Pantallas de simulación (/impresoras y /whatsapp); en el local real: false
SIMULADORES=true

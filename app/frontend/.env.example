# Variables de la web (Next.js). En la laptop no hace falta ninguna: todo funciona junto.
# En Vercel se crean DOS proyectos con este mismo código y se cambia solo NEXT_PUBLIC_MODO.

# Dirección de la API (Render). Sin ella se usa el mismo equipo en el puerto 3001.
# NEXT_PUBLIC_API_URL=https://polleria-api.onrender.com

# comensal: portada, carta QR (/m/…), pasarela, comprobantes y Libro de Reclamaciones.
# personal: mozo, caja, cocina, reparto, administración, reportes y QR para imprimir.
# Sin valor: todo en un mismo sitio (desarrollo).
# NEXT_PUBLIC_MODO=comensal

# Solo en el proyecto del personal: dirección del sitio del comensal. La usan los QR de las
# mesas, los comprobantes por WhatsApp y la redirección de /m/… al dominio correcto.
# NEXT_PUBLIC_URL_COMENSAL=https://polleria-carta.vercel.app
